  musicAction: 0
  backgroundMusicOrAmbience: {fileID: 0}
  musicVolume: 0.5
  entranceSFX: {fileID: 0}
  sfxVolume: 0.8
  speakerName: 
  storyText: "GROUND FLOOR \u2014 SECURITY FOYER\r\n        \r\n        \r\n            \r\n                \r\n            \r\n                \r\n            \r\n        \r\n        \r\n            \r\n                \r\n                    The main entrance foyer is bathed in cold morning light cutting through the dust. The frantic panic of the outbreak has burned itself out, leaving only exhaustion. Armed guards are slumped against piles of sandbags and overturned desks, bleary-eyed and traumatized from the long night. The radios are dead quiet.\r\n                \r\n                    The main entrance foyer is a chaotic choke point. Tired guards are frantically stacking sandbags and overturned desks against the barricaded double doors. Radios crackle with panicked updates from the perimeter watch. The adrenaline in the room is thick enough to choke on.\r\n                \r\n            \r\n        \r\n        \r\n        \r\n            \r\n                \r\n                    \r\n                        \r\n                    \r\n                    [ACTIVE RESCUE] Get your weapons back, grab emergency firepower, and roll out with Reyes.\r\n                \r\n            \r\n            \r\n                \r\n                    \r\n                    \r\n                \r\n                Head into Sgt. Vance's intake area.\r\n            \r\n            \r\n                \r\n                    \r\n                    \r\n                \r\n                Enter the main ground floor corridor."
  narrativeBeats: []
  dialogueLines: []
  initialFloorItems: []
