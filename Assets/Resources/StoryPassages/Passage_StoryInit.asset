  storyText: "/*  \n    =================================================================\n    STORYINIT: THE CORE ENGINE DATABASE\n    Sunday's Last Breath - Twine Survival Horror\n    =================================================================\n*/"
  narrativeBeats:
  - "/* -----------------------------------------------------------------\n   1. PLAYER IDENTITY & PROGRESSION\n   ----------------------------------------------------------------- */"
  - '/* Control flag: Set to false in the Prologue to enable hunger/thirst decay */'
  - "/* -----------------------------------------------------------------\n   2. VITALS (0 - 100 SCALE)\n   ----------------------------------------------------------------- */"
  - "/* 100 = Full, 0 = Starving */\n  /* 100 = Hydrated, 0 = Dehydrated */\n      /* 0 = Monster, 100 = Saint */"
  - "/* -----------------------------------------------------------------\n   3. ATTRIBUTES (1 - 10 SCALE)\n   ----------------------------------------------------------------- */"
  - /* Customization points for the 'Student' class on a 1-10 scale */
  - "/* -----------------------------------------------------------------\n   4. SKILLS (Proficiency Levels)\n   ----------------------------------------------------------------- */"
  - "/* -----------------------------------------------------------------\n   5. TRAITS & LORE LOGIC\n   ----------------------------------------------------------------- */"
  - "/* Stores unlocked flavor text and logs */\n        /* Track progress through hobby selection */\n   /* Prevents picking the same hobby twice */"
  - "/* -----------------------------------------------------------------\n   6. INVENTORY & EQUIPMENT SYSTEM\n   ----------------------------------------------------------------- */"
  - /* Tracks items dropped in specific passages */
  - "/* -----------------------------------------------------------------\n   7. WORLD TIME & CLOCK\n   ----------------------------------------------------------------- */"
  - "/* -----------------------------------------------------------------\n   8. MASTER ITEM DATABASE (setup.items)\n   ----------------------------------------------------------------- */\n\", \n        type: \"weapon\", acc: 60, targets: 1, desc: \"Reliable 9mm police pistol.\" \n    },\n    \"Makarov\": { \n        icon: \"\", \n        type: \"weapon\", acc: 55, targets: 1, desc: \"Rugged Soviet steel.\" \n    },\n    \"Taurus\": { \n        icon: \"\", \n        type: \"weapon\", acc: 50, targets: 1, desc: \"Snub-nose revolver.\" \n    },\n    \"Revolver .38\": { \n        icon: \"\", \n        type: \"weapon\", acc: 55, targets: 1, desc: \"Civilian defense weapon.\" \n    },\n    \"Five-Seven\": { \n        icon: \"\", \n        type: \"weapon\", acc: 75, targets: 1, desc: \"High velocity pistol.\" \n    },\n    \"Magnum\": { \n        icon: \"\", \n        type: \"weapon\", acc: 65, targets: 1, desc: \"Hand cannon. High recoil.\" \n    },\n    \"MP5\": { \n        icon: \"\", \n        type: \"weapon\", acc: 75, targets: 3, desc: \"9mm SMG. Fast firing.\" \n    },\n    \"M4A1\": { \n        icon: \"\", \n        type: \"weapon\", acc: 80, targets: 2, desc: \"Military carbine.\" \n    },\n    \"Barret M82\": { \n        icon: \"\", \n        type: \"weapon\", acc: 95, targets: 1, desc: \"Anti-materiel rifle.\" \n    },\n    \"Spas-12\": { \n        icon: \"\", \n        type: \"weapon\", acc: 60, targets: 3, desc: \"Combat Shotgun.\" \n    },\n    \"Remington 870\": { \n        icon: \"\", \n        type: \"weapon\", acc: 70, targets: 2, desc: \"Pump-action shotgun.\" \n    },\n    \"Compound Bow\": { \n        icon: \"\", \n        type: \"weapon\", acc: 85, desc: \"Silent. Retrievable ammo.\" \n    },\n    \n    /* --- MELEE WEAPONS --- */\n    \"Crowbar\": { \n        icon: \"\", \n        type: \"weapon\", acc: 90, desc: \"Steel tool. Breaches crates.\" \n    },\n    \"Combat Knife\": { \n        icon: \"\", \n        type: \"weapon\", acc: 80, desc: \"Military blade. Silent.\" \n    },\n    \"Hunting Knife\": { \n        icon: \"\", \n        type: \"weapon\", acc: 85, desc: \"Serrated blade. High damage.\" \n    },\n    \"Kitchen Knife\": { \n        icon: \"\", \n        type: \"weapon\", acc: 70, desc: \"Chef's knife. Sharp but fragile.\" \n    },\n    \"Sledgehammer\": { \n        icon: \"\", \n        type: \"weapon\", acc: 50, desc: \"Breaches doors. Slow.\" \n    },\n    \"Scalpel\": { \n        icon: \"\", \n        type: \"weapon\", acc: 90, desc: \"Medical blade. Precision.\" \n    },\n    \"Golf Club\": { \n        icon: \"\", \n        type: \"weapon\", acc: 60, desc: \"Medium reach.\" \n    },\n    \"Baseball Bat\": { \n        icon: \"\", \n        type: \"weapon\", acc: 70, desc: \"Good knockback.\" \n    },\n    \"Cane\": { \n        icon: \"\", \n        type: \"weapon\", acc: 50, desc: \"Walking stick.\" \n    },\n    \"Tire Iron\": { \n        icon: \"\", \n        type: \"weapon\", acc: 60, desc: \"Rusted metal club.\" \n    },\n    \n    /* --- AMMUNITION --- */\n    \"9mm Ammo\": { \n        icon: \"\", \n        type: \"ammo\", stack: true, max: 60, desc: \"Pistol rounds.\" \n    },\n    \"5.56mm Ammo\": { \n        icon: \"\", \n        type: \"ammo\", stack: true, max: 60, desc: \"Rifle rounds.\" \n    },\n    \".38 Ammo\": { \n        icon: \"\", \n        type: \"ammo\", stack: true, max: 20, desc: \"Revolver rounds.\" \n    },\n    \".500 Magnum\": { \n        icon: \"\", \n        type: \"ammo\", stack: true, max: 12, desc: \"Heavy rounds.\" \n    },\n    \".50 Cal\": { \n        icon: \"\", \n        type: \"ammo\", stack: true, max: 10, desc: \"Anti-materiel rounds.\" \n    },\n    \"Shotgun Shells\": { \n        icon: \"\", \n        type: \"ammo\", stack: true, max: 20, desc: \"Buckshot.\" \n    },\n    \"Arrows\": { \n        icon: \"\", \n        type: \"ammo\", stack: true, max: 20, desc: \"Silent ammo.\" \n    },\n    \n    /* --- WEARABLES --- */\n    \"Leather Jacket\": { \n        icon: \"\", \n        type: \"body\", desc: \"Minor bite protection.\" \n    },\n    \"Tactical Vest\": { \n        icon: \"\", \n        type: \"body\", desc: \"Ballistic protection.\" \n    },\n    \"T-Shirt\": { \n        icon: \"\", \n        type: \"body\", desc: \"No protection.\" \n    },\n    \"Jeans\": { \n        icon: \"\", \n        type: \"pants\", desc: \"Durable denim.\" \n    },\n    \"Hiking Boots\": { \n        icon: \"\", \n        type: \"boots\", desc: \"+Stamina Efficiency.\" \n    },\n    \"Running Shoes\": { \n        icon: \"\", \n        type: \"boots\", desc: \"Low noise.\" \n    },\n    \"Sneakers\": { \n        icon: \"\", \n        type: \"boots\", desc: \"Comfortable.\" \n    },\n    \"Hard Hat\": { \n        icon: \"\", \n        type: \"head\", desc: \"Impact protection.\" \n    },\n    \"Tinfoil Hat\": { \n        icon: \"\", \n        type: \"head\", desc: \"Blocks signals?\" \n    },\n    \"Glasses\": { \n        icon: \"\", \n        type: \"head\", desc: \"Vision correction.\" \n    },\n    \n    /* --- CONSUMABLES --- */\n    \"Bottled Water\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 5, stamina: 10, thirst: 30, desc: \"Hydration.\" \n    },\n    \"Canned Food\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 20, stamina: 20, hunger: 40, desc: \"Preserved food.\" \n    },\n    \"Beef Jerky\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 10, stamina: 30, hunger: 30, desc: \"High protein.\" \n    },\n    \"Stale Coffee\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, stamina: 10, thirst: 10, desc: \"Bitter. +10 Stamina.\" \n    },\n    \"Energy Bar\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 5, stamina: 50, hunger: 20, desc: \"+50 Stamina.\" \n    },\n    \"Bag of Chips\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 5, stamina: -10, hunger: 15, desc: \"Greasy junk food.\" \n    },\n    \"Whiskey\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 10, stamina: 0, hum: 10, thirst: 5, desc: \"+Morale / -Intellect.\" \n    },\n    \"Bottle of Vodka\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, hum: 10, thirst: 5, desc: \"Strong alcohol.\" \n    },\n    \"Family Photo\": { \n        icon: \"\", \n        type: \"consumable\", stack: false, hum: 15, desc: \"+15 Humanity.\" \n    },\n    \"First Aid Kit\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 100, desc: \"Full Heal.\" \n    },\n    \"Bandage\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 15, desc: \"Stops bleeding.\" \n    },\n    \"Painkillers\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 10, desc: \"Reduces pain.\" \n    },\n    \"Antibiotics\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 10, desc: \"Cures Sickness.\" \n    },\n    \"Inhaler\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, heal: 0, stamina: 100, desc: \"Restores Breath.\" \n    },\n    \"Sleeping Pills\": { \n        icon: \"\", \n        type: \"consumable\", stack: true, desc: \"Forces sleep.\" \n    },\n    \n    /* --- SKILL BOOKS --- */\n    \"Manual: Mechanics\": { \n        icon: \"\", \n        type: \"consumable\", skill: \"tech\", desc: \"+1 Tech Skill.\" \n    },\n    \"Manual: Anatomy\": { \n        icon: \"\", \n        type: \"consumable\", skill: \"medicine\", desc: \"+1 Medicine Skill.\" \n    },\n    \"Textbook\": { \n        icon: \"\", \n        type: \"consumable\", xp: 50, desc: \"+50 XP.\" \n    },\n    \n    /* --- UTILITY & TOOLS --- */\n    \"Flashlight\": { \n        icon: \"\", \n        type: \"item\", desc: \"Infinite charge LED.\" \n    },\n    \"Fuse\": { \n        icon: \"\", \n        type: \"item\", stack: true, desc: \"Electronic fuse.\" \n    },\n    \"Work Gloves\": { \n        icon: \"\", \n        type: \"item\", desc: \"Protects hands.\" \n    },\n    \"Bleach\": { \n        icon: \"\", \n        type: \"item\", desc: \"Cleaning chemical.\" \n    },\n    \"Duct Tape\": { \n        icon: \"\", \n        type: \"item\", desc: \"Fixes everything.\" \n    },\n    \"Lockpicks\": { \n        icon: \"\", \n        type: \"item\", desc: \"Open locks silently.\" \n    },\n    \"Multi-Tool\": { \n        icon: \"\", \n        type: \"item\", desc: \"Screw, cut, fix.\" \n    },\n    \"Binoculars\": { \n        icon: \"\", \n        type: \"item\", desc: \"Scout ahead.\" \n    },\n    \"Compass\": { \n        icon: \"\", \n        type: \"item\", desc: \"Navigation.\" \n    },\n    \"Lighter\": { \n        icon: \"\", \n        type: \"item\", desc: \"Fire source.\" \n    },\n    \"Jerry Can\": { \n        icon: \"\", \n        type: \"item\", desc: \"Fuel storage.\" \n    },\n    \"Car Keys\": { \n        icon: \"\", \n        type: \"item\", desc: \"Keys for a Sedan.\" \n    },\n    \"Bluetooth Speaker\": { \n        icon: \"\", \n        type: \"item\", desc: \"Electronic junk.\" \n    },\n    \"Ceramic Mug\": { \n        icon: \"\", \n        type: \"item\", desc: \"Distraction item.\" \n    },\n    \"Hand Sanitizer\": { \n        icon: \"\", \n        type: \"item\", desc: \"Hygiene.\" \n    },\n    \"Pepper Spray\": { \n        icon: \"\", \n        type: \"item\", desc: \"Stun human enemies.\" \n    },\n    \"Designer Bag\": { \n        icon: \"\", \n        type: \"item\", desc: \"Expensive fashion.\" \n    },\n    \"Gold Ring\": { \n        icon: \"\", \n        type: \"item\", desc: \"Valuable trade item.\" \n    },\n    \"Luxury Watch\": { \n        icon: \"\", \n        type: \"item\", desc: \"High value trade item.\" \n    },\n    \"Encyclopedia\": { \n        icon: \"\", \n        type: \"item\", desc: \"Heavy book.\" \n    },\n    \"Cigarettes\": { \n        icon: \"\", \n        type: \"item\", stack: true, hum: 5, desc: \"+Humanity. Trade.\" \n    },\n    \"Deck of Cards\": { \n        icon: \"\", \n        type: \"item\", desc: \"Gambling.\" \n    },\n    \"Old Map\": { \n        icon: \"\", \n        type: \"item\", desc: \"Local map.\" \n    },\n    \"Guitar\": { \n        icon: \"\", \n        type: \"item\", desc: \"Musical instrument.\" \n    },\n    \"Batteries\": { \n        icon: \"\", \n        type: \"item\", stack: true, desc: \"Standard AA batteries.\" \n    },\n    \"Rope\": { \n        icon: \"\", \n        type: \"item\", desc: \"Twelve meters of strong nylon rope.\" \n    }\n}>>"
  - "/* -----------------------------------------------------------------\n   9. GAMEPLAY MAPPINGS\n   ----------------------------------------------------------------- */"
  - "/* -----------------------------------------------------------------\n   10. ENGINE FUNCTIONS (JAVASCRIPT HELPERS)\n   ----------------------------------------------------------------- */"
  - "/* --- ADD ITEM (WITH SPILLOVER LOGIC) --- */\n i.id === id);\n        if (found) { \n            found.qty += qty; \n            return true; \n        }\n    }\n    \n    /* 2. Check for empty slots */\n    if (targetList.length  i.id === id);\n            if (floorStack) {\n                floorStack.qty += qty;\n                alert(\"Inventory Full! The \" + id + \" fell to the floor.\");\n                return true;\n            }\n        }\n        \n        roomLoot.push({ id: id, qty: qty });\n        alert(\"Inventory Full! The \" + id + \" fell to the floor.\");\n        return true; \n    }\n}>>"
  - "/* --- REMOVE ITEM --- */\n i.id === id);\n    if (index > -1) {\n        State.variables.inventory.splice(index, 1);\n    }\n}>>"
