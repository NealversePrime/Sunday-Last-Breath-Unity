  m_Name: Passage_Prologue_Menu
  m_EditorClassIdentifier: Assembly-CSharp::SundayLastBreath.Data.StoryPassageData
  passageId: Prologue_Menu
  passageTitle: PROLOGUE MENU
  associatedRoomId: 
