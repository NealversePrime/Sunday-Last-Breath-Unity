  m_Name: Passage_Act2_5_MarcusCabin
  m_EditorClassIdentifier: Assembly-CSharp::SundayLastBreath.Data.StoryPassageData
  passageId: Act2_5_MarcusCabin
  passageTitle: ACT2 5 MARCUSCABIN
  associatedRoomId: 
  backdropSprite: {fileID: 0}
