  storyText: /* Time is frozen during intro */
  narrativeBeats:
  - "/* Top Stage: Fixed TV Image Overhead */\r\n    \r\n        \r\n            /* TV starts dim/off to sell the peaceful Saturday night */\r\n            \r\n            SSSHHHHHKKKKK..."
  - "/* Bottom Fixed Dialogue Box */\r\n    \r\n        SYSTEM / NARRATION"
  - "CLICK TO CONTINUE \u25B6"
  - "/* Hidden Native SugarCube Click Prompt */\r\n        \r\n            \r\n                \r\n                \r\n                    \r\n                        /* JUMPSCARE: Audio and Visuals trigger together */\r\n                        setup.sound.play(\"static\", \"audio/sfx/static.mp3\", true, 0.4);\r\n                        $('#tv-screen').css('opacity', '1');\r\n                        $('#tv-glitch').show();\r\n                    \r\n                    \r\n                \r\n                    \r\n                \r\n                    \r\n                        /* SIRENS FADE IN */\r\n                        setup.sound.play(\"siren\", \"audio/sfx/sirens.mp3\", true, 0.3);\r\n                    \r\n                    \r\n                \r\n                    \r\n                        /* SHORT SCREAM */\r\n                        setup.sound.play(\"scream\", \"audio/sfx/scream.mp3\", false, 0.9);\r\n                    \r\n                    \r\n                \r\n                    \r\n                    \r\n                    /* Reveal the character creation button in the action area */"
  - "/* Fade out atmosphere over 2 seconds */\r\n                                    setup.sound.fade(\"static\", 2000);\r\n                                    setup.sound.fade(\"siren\", 2000);\r\n                                    \r\n                                    setTimeout(function() {\r\n                                        Engine.play(\"Create_Gender\");\r\n                                    }, 2000);\r\n                                \r\n                            \r\n                        \r\n                    \r\n                    \r\n                    /* Remove the advance link and blinking cursor so the player must click the button */"
  - /* Kick off the first line of text once the passage is fully rendered to the screen */
