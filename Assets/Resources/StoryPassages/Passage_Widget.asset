%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e5243d49411170e49a1bac6c9ca10949, type: 3}
  m_Name: Passage_Widget
  m_EditorClassIdentifier: Assembly-CSharp::SundayLastBreath.Data.StoryPassageData
  passageId: Widget
  passageTitle: WIDGET
  associatedRoomId: widget
  backdropSprite: {fileID: 0}
  keepPreviousBackdrop: 0
  animatedBackdropFrames: []
  animationFPS: 8
  musicAction: 0
  backgroundMusicOrAmbience: {fileID: 0}
  musicVolume: 0.5
  entranceSFX: {fileID: 0}
  sfxVolume: 0.8
  speakerName: 
  storyText: "/* ========================================================================\r\n   WIDGET LIBRARY: CORE SYSTEMS\r\n   Includes: UI, Survival Logic, Inventory, Time, Map, and Radar Systems\r\n   ======================================================================== */"
  narrativeBeats:
  - "/* -----------------------------------------------------------\r\n   SECTION 1: UI & DIALOGUE ELEMENTS\r\n   ----------------------------------------------------------- */"
  - "/* Usage:  */\r\n    \r\n        \r\n            \r\n        \r\n        \r\n            $args[0]\r\n            $args[3]"
  - "/* Visual progress bars for Vitals (HP/Stamina) */\r\n    \r\n        $args[2]\r\n        $args[0]/$args[1]"
  - "No traits or perks acquired.\r\n        \r\n    \r\n        \r\n            \r\n                \r\n                \r\n                /* If the perk is a destructive weakness, give it a red border. Otherwise, gold. */\r\n                \r\n                \r\n                    \r\n                    \r\n                        /* SMART CHECK: If it's an image path, load the image. If you haven't replaced the emoji yet, it falls back to text safely! */\r\n                        \r\n                            \r\n                        \r\n                            _t.icon\r\n                        \r\n                    \r\n                    \r\n                    \r\n                        _t.name\r\n                        _t.desc"
  - "/* -----------------------------------------------------------\r\n   SECTION 2: SURVIVAL LOGIC\r\n   ----------------------------------------------------------- */"
  - /* Handles Stamina costs and "Burn the Muscle" HP drain */
  - /* 1. Calculate Average Fuel (Hunger + Thirst) */
  - '/* 2. FATIGUE TAX: Penalty multiplier for low fuel */'
  - "/* 3. DEDUCTION: Pull cost from Stamina, and overflow to Health if exhausted */\r\n        = _actualCost>>"
  - "/* -----------------------------------------------------------\r\n   SECTION 3: INVENTORY & EQUIPMENT\r\n   ----------------------------------------------------------- */"
  - "/* Paper-doll style tactical equipment loadout */\r\n    \r\n        ACTIVE LOADOUT\r\n        \r\n            \r\n                \r\n                    WPN\r\n                \r\n                    \r\n                \r\n            \r\n            \r\n                \r\n                    HEAD\r\n                \r\n                    \r\n                \r\n            \r\n            \r\n                \r\n                    BODY\r\n                \r\n                    \r\n                \r\n            \r\n            \r\n                \r\n                    LEGS\r\n                \r\n                    \r\n                \r\n            \r\n            \r\n                \r\n                    FEET"
  - "/* Grid system display for the player inventory backpack */\r\n    \r\n        BACKPACK\r\n        \r\n            \r\n                \r\n                    \r\n                        \r\n                            \r\n                             1>>\r\n                                x"
  - "/* -----------------------------------------------------------\r\n   SECTION 4: TIME SYSTEMS\r\n   ----------------------------------------------------------- */"
  - "/* Digital clock display interface */\r\n    \r\n        \r\n            $gameDate.dayName | $gameDate.month $gameDate.date\r\n        \r\n        \r\n            0$gameDate.hour:0$gameDate.minute\r\n        \r\n        \r\n            DAY $gameDate.dayCount"
  - /* Time progression math with automatic hours/days rollover logic */
  - = 60>>
  - = 24>>
  - "/* -----------------------------------------------------------\r\n   SECTION 5: MAP SYSTEMS (MODULAR)\r\n   ----------------------------------------------------------- */"
  - "$activeMap\r\n            \r\n            \r\n                \r\n                    CURRENTLY: $locationName$currentLocation"
  - "/* NEW: Zoom Controls Overlay */\r\n            \r\n                +\r\n                -"
  - '/* NEW: SVG Map Container */'
  - Map unavailable.
  - "/* -----------------------------------------------------------\r\n   SECTION 6: RADAR CHARTS & REPUTATION\r\n   ----------------------------------------------------------- */"
  - /* Prints base radar SVG elements for stats (STR, INT, etc.) */
  - /* Prints base radar SVG elements for active skills */
  - /* Increases Safehouse reputation up to the maximum capacity of 100 */
  - /* --- OBJECTIVE LOG WIDGETS --- */
  - "/* Only show objectives if the player has finished setting up their character */\r\n         0>>\r\n            \r\n                ACTIVE LOGS\r\n                \r\n                    \r\n                        \r\n                        \r\n                            \r\n                                [&nbsp;]\r\n                                _obj.desc\r\n                            \r\n                        \r\n                            \r\n                                [\u2713]\r\n                                _obj.desc"
  - /* Sets up the VN layout with character image & initial text */
  - "$args\r\n      $args[2]"
  - /* Replaces the text inside the dialogue box without scrolling */
  - "$args[0]\r\n  $args"
  - /* Option to swap character portrait image dynamically */
  - "/* \r\n       Argumen 0: Kecepatan kursor (Default 2.8)\r\n       Argumen 1: Lebar Safe Zone dalam % (Default 20) \r\n       Contoh pemanggilan: \r\n    */"
  - "\u26A0\uFE0F MANUAL DISARM INITIATED\r\n        Keep the tension steady. Click the button when the red line is inside the GREEN safe zone!"
  - HOLD BREATH & STOP
  - "setTimeout(function() {\r\n            var cursor = document.getElementById(\"qte-cursor\");\r\n            var btn = document.getElementById(\"qte-btn\");\r\n            if (!cursor || !btn) return;\r\n            \r\n            var position = 0;\r\n            var direction = 1;\r\n            \r\n            /* Mengambil parameter dari Twine */\r\n            var speed = State.temporary.qteSpeed;\r\n            var safeMin = State.temporary.qteLeft;\r\n            var safeMax = State.temporary.qteRight;\r\n            \r\n            var interval = setInterval(function() {\r\n                if (!document.getElementById(\"qte-cursor\")) {\r\n                    clearInterval(interval);\r\n                    return;\r\n                }\r\n                position += speed * direction;\r\n                if (position >= 98 || position = safeMin && position <= safeMax) {\r\n                    btn.innerText = \"SUCCESS! TENSION HELD.\";\r\n                    btn.style.borderColor = \"var(--accent-green)\";\r\n                    btn.style.color = \"var(--accent-green)\";\r\n                    /* Mengeklik link 'WIN' yang disembunyikan di passage pemanggil */\r\n                    setTimeout(function() { document.querySelector(\"#qte-win-trigger a, #qte-win-trigger button\").click(); }, 1500);\r\n                } else {\r\n                    btn.innerText = \"FAILED! THE WIRE SNAPPED!\";\r\n                    btn.style.borderColor = \"var(--accent-red)\";\r\n                    btn.style.color = \"var(--accent-red)\";\r\n                    /* Mengeklik link 'LOSE' yang disembunyikan di passage pemanggil */\r\n                    setTimeout(function() { document.querySelector(\"#qte-lose-trigger a, #qte-lose-trigger button\").click(); }, 1500);\r\n                }\r\n            };\r\n        }, 100);"
  dialogueLines:
  - introNarration: 
    speakerName: Name
    side: 0
    avatarSprite: {fileID: 0}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: Dialogue content
    outroNarration: 
    requiresStoryFlag: 
    requiresNotFlag: 
  initialFloorItems: []
  choices: []
