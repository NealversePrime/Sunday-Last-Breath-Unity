  - introNarration: 
    speakerName: You
    side: 0
    avatarSprite: {fileID: 21300000, guid: 04a95c7136264fc6d4e69cfcfe253bf5, type: 3}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: '''He''s somebody''s kid. I didn''t know him. I''m not going to start crying for him now.'''
    outroNarration: 
    requiresStoryFlag: 
    requiresNotFlag: 
