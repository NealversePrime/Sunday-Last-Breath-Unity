  m_Name: Passage_Act2_ParkingLot_Combat
  m_EditorClassIdentifier: Assembly-CSharp::SundayLastBreath.Data.StoryPassageData
  passageId: Act2_ParkingLot_Combat
  passageTitle: ACT2 PARKINGLOT COMBAT
  associatedRoomId: 
