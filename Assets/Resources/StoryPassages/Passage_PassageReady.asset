  speakerName: 
  storyText: "/* ====================================================================================\n   MODULE 1: PASSIVE SURVIVAL DECAY (The Struggle)\n   Runs every turn except during character creation.\n   ==================================================================================== */"
  narrativeBeats:
  - "/* --- 1.1: Resource Depletion --- */\n\t   /* Hunger drops 0.5 per action */\n\t   /* Thirst drops 1.0 per action (dehydrates faster) */\n\t\n\t/* --- 1.2: Starvation & Dehydration Damage --- */\n\t/* If either meter hits 0, the player begins losing HP every turn */\n\t\n\t\t         /* Dehydration is lethal (5 DMG) */\n\t\n\t\n\t\n\t\t         /* Starvation is slower (2 DMG) */"
  - "/* ====================================================================================\n   MODULE 2: STAT CLAMPING & CALIBRATION\n   Ensures variables never exceed maximum limits or break the UI.\n   ==================================================================================== */"
  - "/* --- 2.1: Vitals (0-100 Scale) --- */\n/*  */\n               /* Caps HP at its max value */\n /* Caps Stamina */\n           /* Caps Hunger at 100% */\n           /* Caps Thirst at 100% */\n                 /* Caps Humanity at 100% */"
  - '/* --- 2.2: Attributes (1-10 Scale) --- */

    /* Note: We clamp these to 10 in case of buffs/bonuses */'
  - "/* ====================================================================================\n   MODULE 3: ENGINE LOGIC & STATE CHECKS\n   Handles critical game-ending conditions and time passage.\n   ==================================================================================== */"
  - '/* --- 3.1: Death Check --- */'
  - /* Immediately force game over if dead */
  - '/* --- 3.2: Chronos Engine --- */'
  - /* Automatically add 1 minute per passage */
  dialogueLines: []
  initialFloorItems: []
  choices: []
