  entranceSFX: {fileID: 0}
  sfxVolume: 0.8
  speakerName: 
  storyText: /* DYNAMIC LEADER & AVATAR CONFIGURATION */
  narrativeBeats:
  - /* If player enters office before triggering the briefing, route them directly into the story briefing */
  - "1ST FLOOR \u2014 COMMAND & HEADMASTER'S OFFICE"
  - Topographic maps and radio logs clutter the desk. The red emergency receiver light continues to pulse on the desk console.
  - Matriarch Evelyn looks up sharply as the doors swing open, her face etched with deep tension.
  - "team won't last long against that horde. Get down to the 7-Eleven with Reyes before it's too late!\">>\r\n                        \r\n                    \r\n                        \r\n                    \r\n                \r\n                    \r\n                    The command office is humming with coordinated purpose. Maps of the surrounding county are pinned with green clearance markers."
  - "Your mother and father stand together behind the mahogany desk. Your dad places a firm, proud hand on your shoulder while your mom reviews regional perimeter updates.\r\n                    \r\n                        \r\n                            _leaderName looks up from the supply manifests with a warm, intimate smile. Evelyn stands beside them, nodding in deep respect.\r\n                        \r\n                            _leaderName looks up from the supply manifests with a warm, intimate smile. Evelyn stands beside , nodding in deep respect.\r\n                        \r\n                    \r\n                        Commander Hayes and Matriarch Evelyn coordinate logistics across the compound with radios and defense manifests."
  - '[ACTIVE RESCUE] Unseal your confiscated weapons, requisition heavy ordnance, and roll out to Route 9.'
  - Return to the Upper Hallway Center corridor.
  dialogueLines:
  - introNarration: 
    speakerName: Mom (Evelyn)
    side: 1
    avatarSprite: {fileID: 21300000, guid: d44660ccf987768fc8f51e4ae4a327b2, type: 3}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: $firstName! Why are you still in the building? Every minute that passes is another minute your father is trapped in that cooler! Please, get to Route 9!
    outroNarration: 
    requiresStoryFlag: 
    requiresNotFlag: 
  - introNarration: 
    speakerName: Matriarch Evelyn
    side: 1
    avatarSprite: {fileID: 21300000, guid: d44660ccf987768fc8f51e4ae4a327b2, type: 3}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: $firstName, the clock is ticking. _leaderName and their team won't last long against that horde. Get down to the 7-Eleven with Reyes before it's too late!
    outroNarration: 
    requiresStoryFlag: 
    requiresNotFlag: 
  - introNarration: 
    speakerName: Matriarch Evelyn
    side: 1
    avatarSprite: {fileID: 21300000, guid: d44660ccf987768fc8f51e4ae4a327b2, type: 3}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: $firstName, the clock is ticking. _leaderName and <<print _poss>> team won't last long against that horde. Get down to the 7-Eleven with Reyes before it's too late!
    outroNarration: 
    requiresStoryFlag: 
    requiresNotFlag: 
  - introNarration: 
    speakerName: Matriarch Evelyn
    side: 1
    avatarSprite: {fileID: 21300000, guid: d44660ccf987768fc8f51e4ae4a327b2, type: 3}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: "Reyes and you need to roll out immediately. Commander Hayes is our chief tactical officer\u2014we cannot afford to lose him on Route 9."
    outroNarration: 
    requiresStoryFlag: 
    requiresNotFlag: 
  initialFloorItems: []
  choices:
  - choiceLabel: "\U0001F52B Proceed to Armory with Reyes to Gear Up - RESCUE PREP"
    choiceSubtitle: '[ACTIVE RESCUE] Unseal your confiscated weapons, requisition heavy ordnance, and roll out to Route 9.'
