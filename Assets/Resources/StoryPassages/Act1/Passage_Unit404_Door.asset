  m_Script: {fileID: 11500000, guid: e5243d49411170e49a1bac6c9ca10949, type: 3}
  m_Name: Passage_Unit404_Door
  m_EditorClassIdentifier: Assembly-CSharp::SundayLastBreath.Data.StoryPassageData
  passageId: unit_404_door
  passageTitle: UNIT 404 // MRS. GABLE & BUSTER
  associatedRoomId: hallway_2
  backdropSprite: {fileID: 21300000, guid: 938da64fe6695284d8364716fe0a373b, type: 3}
  keepPreviousBackdrop: 0
  animatedBackdropFrames: []
  animationFPS: 8
  musicAction: 0
  backgroundMusicOrAmbience: {fileID: 0}
  musicVolume: 0.5
  entranceSFX: {fileID: 0}
  sfxVolume: 0.8
  speakerName: ''
  storyText: "You approach the door of Unit 404. Before your knuckles can even tap the wood, a sharp, frightened bark cuts through the quiet, followed by claws frantically scraping against the lower molding.\n\n<color=#F59E0B><b>*WHINE... SCRATCH-SCRATCH*</b></color>\n\nMrs. Gable lives here. She's in her late seventies and lives alone with Buster, her golden retriever. She always gets anxious during loud thunderstorms; the sirens outside must have terrified her.\n\nFrom deep inside, her trembling voice calls out: <i>\"Who's there?! Stay away! I... I have a firearm! Buster, get back!\"</i>\n\nYou hear the heavy, muffled scrape of an oak armoire firmly wedged against the inside of the door. She is panicked, but she managed to barricade herself in completely. Forcing your way inside would destroy her defenses and terrify her for no reason."
  narrativeBeats: []
  dialogueLines:
  - introNarration: "A terrified bark cuts through the door of Unit 404, followed by claws scratching frantically on wood."
    speakerName: "YOU"
    side: 0
    avatarSprite: {fileID: 0}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: "Mrs. Gable and Buster. She's barricaded the armoire against the door. She's terrified, but she's safe inside. I should let her know she isn't alone."
    outroNarration: "The oak dresser holds firmly wedged against the frame."
    requiresStoryFlag: ''
    requiresNotFlag: ''
  initialFloorItems: []
  choices:
  - choiceLabel: "[SOOTHE] Whisper Reassuringly Through the Door"
    choiceSubtitle: "Speak gently through the wood so she knows a friendly neighbor is outside. (+5 Humanity)"
