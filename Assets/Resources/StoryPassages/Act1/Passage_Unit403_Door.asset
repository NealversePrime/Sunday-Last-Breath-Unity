  m_Name: Passage_Unit403_Door
  m_EditorClassIdentifier: Assembly-CSharp::SundayLastBreath.Data.StoryPassageData
  passageId: unit_403_door
  passageTitle: UNIT 403 // SARAH'S APARTMENT
  associatedRoomId: hallway_3
  backdropSprite: {fileID: 21300000, guid: eb6e8907fc2cb5940b540f3408f62fa0, type: 3}
  keepPreviousBackdrop: 0
  animatedBackdropFrames: []
  animationFPS: 8
  musicAction: 0
  backgroundMusicOrAmbience: {fileID: 0}
  musicVolume: 0.5
  entranceSFX: {fileID: 0}
  sfxVolume: 0.8
  speakerName: ''
  storyText: "You try the brass handle of Unit 403. It's locked tight, the deadbolt fully engaged from the outside.\n\n<color=#94A3B8><b>*CLICK-RATTLE*</b></color>\n\nThis is Sarah's place. She works as an ER trauma nurse down at Swedish Medical Center in the city center. Her welcome mat has dried rain spots from yesterday morning, but her running sneakers aren't on the rack outside.\n\nShe was on the 7 PM night shift. With the news feeds showing hospitals overwhelmed and the military barricading the downtown bridges, there's no way she made it home before the city was locked down.\n\nThe peephole is pitch black and there isn't a whisper of sound from within. Nobody is home."
  narrativeBeats: []
  dialogueLines:
  - introNarration: "You rattle the brass handle of Unit 403. Deadbolt engaged tight from the outside."
    speakerName: "YOU"
    side: 0
    avatarSprite: {fileID: 0}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: "Sarah's shoes are gone. She was working the emergency room downtown. With the bridges closed and hospitals swamped, she's trapped in the city center. The apartment is empty."
    outroNarration: "Total darkness inside the peephole."
    requiresStoryFlag: ''
    requiresNotFlag: ''
