  entranceSFX: {fileID: 0}
  sfxVolume: 0.8
  speakerName: ''
  storyText: "The heavy oak shelf is off him. The <b>Car Keys</b> are safely in your pocket.\n\nThe scratched CD player loops endlessly from the corner:\n\n<i>\"...and we danced all night to the best song ever...\"</i>\n\nThe apartment smells like beer, grief, and stale panic. You are the only living thing left here."
  narrativeBeats: []
  dialogueLines:
  - introNarration: "The blaring pop music echoes off empty red solo cups and smashed glass."
    speakerName: "YOU"
    side: 0
    avatarSprite: {fileID: 0}
    animatedAvatarFrames: []
    avatarFPS: 8
    dialogueText: "He's somebody's kid. I didn't know him. I'm not going to start crying for him now. The car keys are mine."
    outroNarration: "The bass shakes the floorboards in an empty apartment."
    requiresStoryFlag: ''
    requiresNotFlag: ''
