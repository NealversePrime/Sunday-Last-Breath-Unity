  m_EditorClassIdentifier: Assembly-CSharp::SundayLastBreath.Data.StoryPassageData
  passageId: Debug_Panel
  passageTitle: DEBUG PANEL
  associatedRoomId: 
  backdropSprite: {fileID: 0}
  keepPreviousBackdrop: 0
  animatedBackdropFrames: []
  animationFPS: 8
  musicAction: 0
  backgroundMusicOrAmbience: {fileID: 0}
  musicVolume: 0.5
  entranceSFX: {fileID: 0}
  sfxVolume: 0.8
  speakerName: 
  storyText: "#dbg { \n        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; \n        color: #e0e0e0; \n        width: 100%;\n        max-width: 900px; \n        margin: 0 auto; \n        background: #0b0b0b; \n        border: 1px solid #282828;\n        border-radius: 8px;\n        box-shadow: 0 10px 30px rgba(0,0,0,0.9);\n        display: flex;\n        flex-direction: column;\n        height: 82vh;\n        max-height: 780px;\n        min-height: 520px;\n        overflow: hidden;\n        position: relative;\n        isolation: isolate; \n        box-sizing: border-box !important;\n    }\n    \n    #dbg, #dbg * { \n        text-decoration: none !important; \n        text-shadow: none !important; \n        box-sizing: border-box !important;\n    }"
  narrativeBeats:
  - "#dbg button {\n        width: auto !important;\n        margin-bottom: 0 !important;\n        position: relative !important;\n        overflow: visible !important;\n        box-sizing: border-box !important;\n        display: inline-flex !important;\n        align-items: center !important;\n        justify-content: center !important;\n        float: none !important;\n    }\n    #dbg button::after {\n        display: none !important;\n    }"
  - "/* TOP TOOLBAR */\n    .dbg-toolbar {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        background: #141414;\n        border-bottom: 1px solid #2a2a2a;\n        padding: 8px 12px;\n        gap: 10px;\n        flex-shrink: 0;\n        z-index: 10;\n        width: 100%;\n    }"
  - ".dbg-toolbar-left {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n    }"
  - ".dbg-toggle-btn {\n        background: #1e1e1e;\n        border: 1px solid #3a3a3a;\n        color: #aaa;\n        border-radius: 4px;\n        padding: 5px 9px;\n        cursor: pointer;\n        display: flex;\n        align-items: center;\n        gap: 6px;\n        font-size: 0.76rem;\n        font-family: inherit;\n        transition: all 0.15s ease;\n        width: auto !important;\n        margin-bottom: 0 !important;\n        flex-shrink: 0;\n    }\n    .dbg-toggle-btn:hover {\n        background: #282828;\n        color: #ff6b35;\n        border-color: #ff6b35;\n    }"
  - ".dbg-title {\n        font-weight: 700;\n        font-size: 0.88rem;\n        letter-spacing: 0.05em;\n        color: #f0f0f0;\n        display: flex;\n        align-items: center;\n        gap: 8px;\n    }"
  - ".dbg-badge {\n        background: rgba(255, 107, 53, 0.15);\n        border: 1px solid rgba(255, 107, 53, 0.4);\n        color: #ff6b35;\n        font-size: 0.68em;\n        padding: 2px 6px;\n        border-radius: 3px;\n        font-weight: 600;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n    }"
  - ".dbg-toolbar-actions {\n        display: flex;\n        align-items: center;\n        gap: 6px;\n    }\n    .dbg-toolbar-actions .db {\n        width: auto !important;\n        margin-bottom: 0 !important;\n        flex-shrink: 0;\n    }"
  - "/* SPLIT VIEW CONTAINER */\n    .dbg-split-container {\n        display: flex;\n        flex: 1;\n        overflow: hidden;\n        position: relative;\n        width: 100%;\n    }"
  - "/* SIDEBAR PANE */\n    \n    \n    .dbg-sidebar {\n        width: 200px;\n        min-width: 130px;\n        max-width: 280px;\n        background: #101010;\n        border-right: 1px solid #222;\n        display: flex;\n        flex-direction: column;\n        flex-shrink: 0;\n        transition: margin-left 0.2s ease;\n        overflow-y: auto;\n    }"
  - ".dbg-sidebar.collapsed {\n        margin-left: -200px;\n    }"
  - ".dbg-sidebar-header {\n        font-size: 0.65em;\n        text-transform: uppercase;\n        letter-spacing: 0.12em;\n        color: #666;\n        padding: 12px 14px 6px;\n        font-weight: bold;\n    }"
  - ".dbg-nav {\n        display: flex;\n        flex-direction: column;\n        gap: 3px;\n        padding: 0 8px 12px;\n    }"
  - ".dbg-nav-item {\n        display: flex;\n        align-items: center;\n        gap: 8px;\n        padding: 7px 9px;\n        background: transparent;\n        border: 1px solid transparent;\n        border-radius: 5px;\n        color: #aaa;\n        font-size: 0.78rem;\n        font-family: inherit;\n        cursor: pointer;\n        text-align: left;\n        transition: all 0.12s ease;\n        width: 100% !important;\n        margin-bottom: 0 !important;\n    }"
  - ".dbg-nav-item:hover {\n        background: #1a1a1a;\n        color: #fff;\n    }"
  - ".dbg-nav-item.active {\n        background: #24140a;\n        color: #ff6b35;\n        border-color: rgba(255, 107, 53, 0.4);\n        font-weight: 600;\n    }"
  - ".dbg-nav-icon {\n        font-size: 1.1em;\n        width: 20px;\n        text-align: center;\n    }"
  - "/* SPLITTER DIVIDER */\n    .dbg-divider {\n        width: 6px;\n        background: #161616;\n        cursor: col-resize;\n        position: relative;\n        flex-shrink: 0;\n        transition: background 0.15s ease;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        border-left: 1px solid #222;\n        border-right: 1px solid #222;\n        z-index: 5;\n    }"
  - ".dbg-divider:hover, .dbg-divider.dragging {\n        background: #ff6b35;\n    }"
  - ".dbg-divider-handle {\n        width: 2px;\n        height: 24px;\n        background: #444;\n        border-radius: 1px;\n    }"
  - "/* CONTENT PANE */\n    .dbg-content {\n        flex: 1;\n        min-width: 0;\n        background: #080808;\n        overflow-y: auto;\n        overflow-x: hidden;\n        padding: 14px 16px;\n        display: flex;\n        flex-direction: column;\n    }"
  - ".dbg-section {\n        display: none;\n        width: 100%;\n    }"
  - ".dbg-section.active {\n        display: block;\n        animation: dbgFadeIn 0.15s ease-out;\n    }"
  - "@keyframes dbgFadeIn {\n        from { opacity: 0; transform: translateY(4px); }\n        to { opacity: 1; transform: translateY(0); }\n    }"
  - ".dbg-section-header {\n        font-size: 0.88rem;\n        font-weight: 700;\n        color: #ff6b35;\n        text-transform: uppercase;\n        letter-spacing: 0.08em;\n        padding-bottom: 8px;\n        border-bottom: 1px solid #242424;\n        margin-bottom: 12px;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n    }"
  - "/* CONTROL ELEMENTS STYLING */\n    .dr { \n        display: flex; \n        align-items: center; \n        gap: 8px; \n        margin-bottom: 8px; \n        background: #121212;\n        padding: 5px 8px;\n        border-radius: 5px;\n        border: 1px solid #1e1e1e;\n        width: 100%;\n        min-width: 0;\n    }\n    \n    .dl { \n        width: 105px; \n        font-size: .76em; \n        color: #aaa; \n        flex-shrink: 0; \n        font-weight: 500;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n    }\n    \n    .ds { \n        flex: 1; \n        min-width: 0;\n        width: 100%;\n        accent-color: #ff6b35; \n        cursor: pointer; \n        height: 14px;\n        margin: 0;\n    }\n    \n    .dv { \n        width: 36px; \n        flex-shrink: 0;\n        text-align: center; \n        color: #ff6b35; \n        font-weight: bold; \n        font-size: .82em; \n        background: #1c0f08;\n        padding: 2px 4px;\n        border-radius: 4px;\n        border: 1px solid rgba(255, 107, 53, 0.3);\n    }\n    \n    #dbg .dbr { \n        display: flex !important; \n        flex-wrap: wrap !important; \n        gap: 6px !important; \n        margin-bottom: 12px !important; \n        width: 100% !important;\n        align-items: center !important;\n    }\n    \n    .dgrid { \n        display: grid; \n        grid-template-columns: repeat(2, minmax(0, 1fr)); \n        gap: 8px 12px; \n        width: 100%;\n    }\n    \n    .dsep { \n        border: none; \n        border-top: 1px solid #222; \n        margin: 14px 0; \n    }\n    \n    #dbg .db, #dbg .dbr button, #dbg button.db { \n        background: #141414 !important; \n        border: 1px solid #333 !important; \n        color: #ccc !important; \n        padding: 5px 10px !important; \n        font-size: .76em !important; \n        font-family: inherit !important; \n        cursor: pointer !important; \n        border-radius: 4px !important;\n        transition: all 0.12s ease !important;\n        display: inline-flex !important;\n        align-items: center !important;\n        justify-content: center !important;\n        gap: 4px !important;\n        min-height: 28px !important;\n        line-height: 1.3 !important;\n        width: auto !important;\n        flex: 0 0 auto !important;\n        margin-bottom: 0 !important;\n        max-width: 100% !important;\n        box-sizing: border-box !important;\n    }\n    \n    .db:hover { \n        border-color: #ff6b35; \n        color: #ff6b35; \n        background: #1a0f08;\n    }\n    \n    .db.on { \n        border-color: #ff6b35; \n        background: #281206; \n        color: #ff6b35; \n        font-weight: bold;\n        box-shadow: 0 0 8px rgba(255, 107, 53, 0.2);\n    }\n    \n    .db.neg { \n        border-color: #444; \n        color: #888; \n    }\n    \n    .db.neg:hover { \n        border-color: #c0392b; \n        color: #c0392b; \n    }\n    \n    .db.neg.on { \n        border-color: #c0392b; \n        background: #220000; \n        color: #e74c3c; \n    }\n    \n    .db.go { \n        border-color: #27ae60; \n        color: #27ae60; \n    }\n    \n    .db.go:hover { background: #04200d; }\n    \n    .db.bad { \n        border-color: #c0392b; \n        color: #c0392b; \n    }\n    \n    .db.bad:hover { background: #220000; }\n    \n    .dsel, .dinput { \n        background: #141414; \n        border: 1px solid #333; \n        color: #ddd; \n        padding: 5px 8px; \n        font-family: inherit; \n        font-size: .78em; \n        border-radius: 4px;\n        min-width: 0;\n    }\n    \n    .item-row { \n        display: flex; \n        align-items: center; \n        gap: 8px; \n        margin-bottom: 8px; \n        width: 100%;\n    }\n    \n    .item-row select { \n        flex: 1; \n        min-width: 0;\n    }\n    \n    .item-row input[type=number] { \n        width: 60px; \n        flex-shrink: 0;\n    }\n    \n    .dnotice { \n        background: #1a0e00; \n        border-left: 3px solid #ff6b35; \n        padding: 8px 12px; \n        font-size: .78em; \n        color: #aaa; \n        margin-bottom: 12px; \n        border-radius: 0 4px 4px 0;\n    }\n    \n    .dskv { \n        min-width: 26px; \n        text-align: center; \n        color: #ff6b35; \n        font-weight: bold; \n        font-size: .85em; \n        background: #1c0f08;\n        padding: 2px 4px;\n        border-radius: 4px;\n        border: 1px solid rgba(255, 107, 53, 0.3);\n    }\n    \n    .dlabel { \n        font-size: .72em; \n        color: #ff6b35; \n        text-transform: uppercase; \n        letter-spacing: 0.08em; \n        margin: 10px 0 5px; \n        font-weight: bold;\n    }"
  - "@media (max-width: 680px) {\n        #dbg { height: 90vh; max-height: none; border-radius: 0; }\n        .dgrid { grid-template-columns: minmax(0, 1fr); }\n        .dbg-sidebar { width: 140px; }\n        .dbg-sidebar.collapsed { margin-left: -140px; }\n        .dl { width: 95px; }\n    }"
  - ".dbg-sidebar {\n        resize: horizontal; overflow-x: hidden;\n    }\n    \n    \n    .dbg-list-grid {\n        display: grid;\n        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n        gap: 8px;\n        margin-bottom: 20px;\n    }\n    .dbg-list-btn {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        background: rgba(255,255,255,0.02);\n        border: 1px solid rgba(255,255,255,0.05);\n        padding: 10px 12px;\n        border-radius: 6px;\n        cursor: pointer;\n        text-align: left;\n        width: 100%;\n        color: #ccc;\n        transition: all 0.15s ease;\n        box-shadow: 0 2px 5px rgba(0,0,0,0.2);\n    }\n    .dbg-list-btn:hover {\n        background: rgba(255,255,255,0.05);\n        border-color: rgba(255,255,255,0.1);\n    }\n    .dbg-list-btn.on {\n        background: rgba(255, 107, 53, 0.1);\n        border: 1px solid rgba(255, 107, 53, 0.4);\n    }\n    .dbg-list-btn.on .list-title {\n        color: #ff6b35;\n    }\n    .dbg-list-btn.neg.on {\n        background: rgba(231, 76, 60, 0.1);\n        border: 1px solid rgba(231, 76, 60, 0.4);\n    }\n    .dbg-list-btn.neg.on .list-title {\n        color: #e74c3c;\n    }\n    \n    .list-icon {\n        font-size: 1.2em;\n        width: 24px;\n        text-align: center;\n        opacity: 0.8;\n    }\n    \n    .list-content {\n        display: flex;\n        flex-direction: column;\n        gap: 3px;\n        flex: 1;\n    }\n    .list-title {\n        font-size: 0.8rem;\n        font-weight: 700;\n        color: #ddd;\n        letter-spacing: 0.02em;\n    }\n    .list-sub {\n        font-size: 0.65rem;\n        color: #888;\n        line-height: 1.2;\n    }\n    .list-sub strong {\n        color: #aaa;\n    }"
  - "\u2630\n                Sidebar\n            \n            \n                \U0001F6E0\uFE0F DEBUG PANEL\n                STATE EDITOR\n            \n        \n        \n            MAX ALL\n            MIN ALL\n            \u21A9 Game"
  - "NAV PANES\n            \n                \n                    \u26A1\n                    Presets\n                \n                \n                    \U0001F3AD\n                    Anchor &amp; Story\n                \n                \n                    \U0001F4CA\n                    Vitals &amp; Stats\n                \n                \n                    \U0001F392\n                    Loadout &amp; Items\n                \n                \n                    \U0001F465\n                    Companions\n                \n                \n                    \U0001F6A9\n                    Quest &amp; Story\n                \n                \n                    \U0001F680\n                    Fast-Travel\n                \n                \n                    \U0001F4C4\n                    Show All"
  - "\u26A1 Quick Character Presets\n                \n                Select an archetype preset to immediately configure stats, skills, and gear.\n                \n                    MAX ALL STATS\n                    Combat Build\n                    Diplomat Build\n                    Agility Build\n                    Police Officer\n                    Doctor\n                    MIN ALL STATS"
  - "\U0001F3AD Anchor &amp; Narrative Choice Switcher\n                \n                \n                    Quickly switch your story Anchor, relationship, player identity, and arrival timing to test Act 3 dialogue and distress broadcasts."
  - "Story Anchor &amp; Relationship Switch\n                \n                    \n                        \U0001F468\u200D\U0001F469\u200D\U0001F466\n                        \n                            PARENTS (ARTHUR &amp; EVELYN)\n                            Evelyn is Mom. Trapped leader is Dad (Arthur Sage). Player is Neal Sage."
  - "\U0001F469\u200D\u2764\uFE0F\u200D\U0001F468\n                        \n                            GIRLFRIEND (ELENA)\n                            Trapped leader is girlfriend Elena. Evelyn is Safehouse Matriarch."
  - "\U0001F468\u200D\u2764\uFE0F\u200D\U0001F468\n                        \n                            BOYFRIEND (LIAM)\n                            Trapped leader is boyfriend Liam. Evelyn is Safehouse Matriarch."
  - "\U0001F9D1\u200D\U0001F91D\u200D\U0001F9D1\n                        \n                            PARTNER (MORGAN)\n                            Trapped leader is non-binary partner Morgan. Evelyn is Safehouse Matriarch."
  - "\U0001F396\uFE0F\n                        \n                            LONE SURVIVOR (COMMANDER HAYES)\n                            Default route. Trapped leader is military tactician Commander Hayes."
  - "Player Identity &amp; Custom Partner Name\n                \n                    \n                        \n                            First Name\n                            \n                        \n                        \n                            Last Name\n                            \n                        \n                    \n                    \n                        \n                            Partner Name\n                            \n                        \n                        \n                            Current Anchor\n                            -"
  - "Arrival Timing (Rain Storm vs. Sunrise)\n                \n                    Controls whether Vance &amp; Reyes treat your arrival as early pre-dawn fog/rain or late morning road dust (Marcus Cabin visited).\n                \n                \n                    \U0001F327\uFE0F Set Arrival: Early Night Storm (Pre-Dawn)\n                    \u2600\uFE0F Set Arrival: Late Sunrise (Marcus Cabin Visited)"
  - "Act 3 Sortie &amp; Armory Status\n                \n                    \U0001F504 Reset Armory Requisition (Allows Re-Picking Kit)\n                    \U0001F513 Restore Confiscated Weapons\n                    \U0001F512 Confiscate Weapons to Stash\n                    \U0001F513 Unlock Officer Reyes Briefing"
  - "\u26A1 Quick Test Teleporters\n                \n                    \n                        \u25B6 Test Meeting Evelyn (Headmaster Office)\n                    \n                    \n                        \u25B6 Test Armory Gear-Up (Sgt. Vance)\n                    \n                    \n                        \u25B6 Test 7-Eleven Arrival (Route 9)"
  - "\U0001F4CA Core Vitals, Attributes &amp; Skills\n                \n                \n                    \n                        \n                            HP Health \n                            \n                            ?\n                        \n                        \n                            STR Strength \n                            \n                            ?\n                        \n                        \n                            AGI Agility \n                            \n                            ?\n                        \n                        \n                            END Endurance \n                            \n                            ?\n                        \n                        \n                            PER Perception \n                            \n                            ?\n                        \n                        \n                            Hunger \n                            \n                            ?\n                        \n                    \n                    \n                        \n                            CHA Charisma \n                            \n                            ?\n                        \n                        \n                            INT Intelligence\n                            \n                            ?\n                        \n                        \n                            HUM Humanity \n                            \n                            ?\n                        \n                        \n                            Stamina \n                            \n                            ?\n                        \n                        \n                            Thirst \n                            \n                            ?\n                        \n                    \n                \n                \n                Core Skills (0 - 5 Scale)\n                \n                    \n                        \n                            Shooting \n                            -\n                            0\n                            +\n                        \n                        \n                            Melee \n                            -\n                            0\n                            +\n                        \n                        \n                            Medicine \n                            -\n                            0\n                            +\n                        \n                    \n                    \n                        \n                            Stealth \n                            -\n                            0\n                            +\n                        \n                        \n                            Scavenge \n                            -\n                            0\n                            +\n                        \n                        \n                            Tech \n                            -\n                            0\n                            +"
  - "Survivor Identity (Roles)\n                \n                    \n    \U0001F46E\n    \n        POLICE OFFICER\n        PERKS: STEADY HANDS &amp; AUTHORITY"
  - "\U0001F477\n    \n        CONSTRUCTION\n        PERKS: BREACHER &amp; IRON GRIP"
  - "\U0001F977\n    \n        BURGLAR\n        PERKS: LOCKSMITH &amp; GHOST"
  - "\U0001F468\u200D\u2695\uFE0F\n    \n        DOCTOR\n        PERKS: FIELD MEDIC &amp; ANATOMIST"
  - "\U0001F454\n    \n        MANAGER\n        PERKS: SILVER TONGUE &amp; INSPIRATION"
  - "\U0001F392\n    \n        STUDENT\n        PERKS: FAST LEARNER &amp; ADRENALINE"
  - "Positive Hobbies\n                \n                    \n    \U0001F45F\n    \n        RUNNER\n        Can Flee twice."
  - "\U0001F527\n    \n        MECHANIC\n        Start cars without keys."
  - "\U0001F3F9\n    \n        HUNTER\n        Spot ambushes early."
  - "\U0001F94A\n    \n        BOXER\n        Unarmed attacks deal heavy damage."
  - "\U0001F3AE\n    \n        GAMER\n        See % Chance of success."
  - "\U0001F392\n    \n        HIKER\n        +2 Inventory Slots."
  - "\U0001F3AF\n    \n        ARCHER\n        Retrieve arrows after kill."
  - "\U0001F33F\n    \n        GARDENER\n        Water/Food heal extra."
  - "\u26BE\n    \n        BASEBALL\n        100% Knockdown on Crit."
  - "\U0001F4DA\n    \n        BOOKWORM\n        Can attempt untrained Skill Checks."
  - "\U0001F989\n    \n        WATCHMAN\n        No accuracy penalty at night."
  - "\u2696\uFE0F\n    \n        DEBATER\n        Detect deceit."
  - "\U0001F373\n    \n        CHEF\n        Create meals from raw items."
  - "\U0001F9D7\n    \n        PARKOUR\n        Access vertical paths."
  - "\U0001F91D\n    \n        VOLUNTEER\n        Heal morale faster."
  - "Survivor Weaknesses\n                \n                    \n    \U0001F6AC\n    \n        SMOKER\n        -20 Stamina. Needs Nicotine."
  - "\U0001F943\n    \n        ALCOHOLIC\n        +20 HP. -1 Int. Reduced Pain."
  - "\U0001FAC1\n    \n        ASTHMATIC\n        Cannot run without Inhaler."
  - "\U0001F453\n    \n        BLIND\n        Needs glasses to shoot."
  - "\U0001F9B5\n    \n        BAD KNEE\n        Cannot Flee."
  - "\U0001F354\n    \n        GLUTTON\n        Must eat 2x Food."
  - "\U0001FA78\n    \n        FRAGILE\n        Bleeding deals double damage."
  - "\U0001F441\uFE0F\n    \n        PARANOID\n        Cannot sleep near NPCs."
  - "\U0001F319\n    \n        INSOMNIAC\n        -10 HP. Night Vision."
  - "\U0001F9FC\n    \n        CLEAN\n        Healing items give +20 HP."
  - "\U0001F3C3\n    \n        COWARD\n        -Damage. High escape chance."
  - "\U0001F525\n    \n        PYRO\n        Fire weapons deal +50% DMG."
  - "\U0001F43A\n    \n        LONE WOLF\n        +10% Stats when alone."
  - "\U0001F4DF\n    \n        LUDDITE\n        Cannot use electronics."
  - "\U0001F54A\uFE0F\n    \n        PACIFIST\n        Unique peaceful choices."
  - "\U0001F4A5\n    \n        CLUMSY\n        Start encounters at high alert."
  - "\U0001F3B2\n    \n        GAMBLER\n        10% Auto-Hit or Auto-Miss."
  - "\U0001F9F8\n    \n        SHELTERED\n        Starts with +20 Humanity."
  - "\U0001F6CD\uFE0F\n    \n        SHOPPER\n        Sell luxury items for 200%."
  - "\U0001F624\n    \n        ARROGANT\n        Companions dislike you."
  - Clear All Traits
