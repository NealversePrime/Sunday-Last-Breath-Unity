  storyText: "/* =================================================================\n   DYNAMIC FLOOR LOOT UI - SLIDING DRAWER OVERLAY\n================================================================= */"
  narrativeBeats:
  - '/* 1. SETUP: Identify current location */'
  - "/* 2. VALIDATION: Check if the floor array exists and has items */\n 0>>"
  - "/* --- 3. FLOATING BADGE (Top Right, Floating) --- */\n    \n        \U0001F4E6 Floor Items ()"
  - "/* --- 4. SLIDING OVERLAY DRAWER --- */\n    \n        \n        /* Drawer Header & Close Button */\n        \n            \u26A0\uFE0F ITEMS ON GROUND\n            \u2716"
  - "/* 5. GENERATION: Loop through room items using your existing logic */\n            \n                \n                /* Pull master data from setup.items database */\n                \n                \n                /* --- Your Existing Item Card Layout --- */\n                \n                    \n                    /* Visual: Item Icon */\n                    \n                        \n                    \n                    \n                    /* Text: Item Name and Quantity */"
  - "(x)\n                    \n                    \n                    /* 6. ACTION: Your Existing Pickup Function */\n                    \n                        \n                            GRAB\n                        \n                    \n                    \n                 /* End loot-item */\n                \n            \n        \n        \n     /* End floor-items-drawer */"
