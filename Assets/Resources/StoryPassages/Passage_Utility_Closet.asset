  passageTitle: UTILITY CLOSET
  associatedRoomId: utility
  backdropSprite: {fileID: 21300000, guid: a5f7cf3ee421cb245a53906ae095f431, type: 3}
  keepPreviousBackdrop: 0
  animatedBackdropFrames: []
