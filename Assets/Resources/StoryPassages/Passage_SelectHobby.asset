  m_Name: Passage_SelectHobby
  m_EditorClassIdentifier: Assembly-CSharp::SundayLastBreath.Data.StoryPassageData
  passageId: SelectHobby
  passageTitle: SELECTHOBBY
  associatedRoomId: 
  backdropSprite: {fileID: 21300000, guid: 26943dc8037623e41b8bf6d931d37420, type: 3}
  keepPreviousBackdrop: 0
  animatedBackdropFrames: []
