  musicAction: 0
  backgroundMusicOrAmbience: {fileID: 0}
  musicVolume: 0.5
  entranceSFX: {fileID: 0}
  sfxVolume: 0.8
  speakerName: 
  storyText: "PRIMARY HOBBY (+1-2 Stats / Items)\n        \n            SECONDARY HOBBY (+1 Stat / Items)\n        \n            SURVIVOR WEAKNESS (Drawbacks)"
  narrativeBeats:
  - "/* =================================================================\n   POSITIVE HOBBIES (Steps 1 & 2)\n   ================================================================= */"
  - "RUNNER\n            You run marathons. Outlast any chase.\n            +STAMINA / +AGI"
  - "MECHANIC\n            Fixing cars and tech comes naturally.\n            +TECH / +STR"
  - "HUNTER\n            Track game in the wild. Spot danger first.\n            +PERC / +SHOOT"
  - "BOXER\n            Know how to take a hit and throw a punch.\n            +STR / +HP"
  - "GAMER\n            Simulations taught strategy and mental acuity.\n            +INT / +TECH"
  - "HIKER\n            Travel long distances carrying heavy loads.\n            +BAG SPACE"
  - "ARCHER\n            Silent hunter. Retrieve ammo after a kill.\n            +PERC / +BOW"
  - "GARDENER\n            You know plants and natural remedies.\n            +INT / +HEAL"
  - "BASEBALL\n            Swing for the fences. High hand-eye coordination.\n            +STR / +MELEE"
  - "BOOKWORM\n            Read about everything. Understand theory.\n            +INT / -STAMINA"
  - "WATCHMAN\n            Used to night shifts. See clearly in the dark.\n            +PERC / +STEALTH"
  - "DEBATER\n            Able to argue your way out of anything.\n            +CHA / +SPEECH\n            \n                \n                \n                \n            \n        \n    \n    \n    \n    \n    \n        \n        \n            CHEF\n            Make the most of incredibly scarce food.\n            +SCAVENGE\n            \n                \n                \n                \n            \n        \n    \n    \n    \n    \n    \n        \n        \n            PARKOUR\n            Urban exploration. Climb vertical obstacles.\n            +AGI / +STEALTH"
  - "VOLUNTEER\n            You help others. Extremely high humanity.\n            +HUMANITY / +MEDIC"
  - "/* =================================================================\n   DESTRUCTIVE WEAKNESSES (Step 3)\n   ================================================================= */"
  - "SMOKER\n            Lungs of tar. Severe addiction penalty.\n            -STAMINA / +PERC"
  - "ALCOHOLIC\n            Numb to pain, but shakes without a drink.\n            -INT / +HP"
  - "ASTHMATIC\n            Running is difficult. Rely on an inhaler.\n            -STAMINA / +INT"
  - "BLIND\n            Terrible vision. Good with close details.\n            -PERC / +TECH\n            \n                \n                \n            \n        \n    \n    \n    \n        \n        \n            BAD KNEE\n            Old injury prevents fleeing. Stand your ground.\n            -AGI / +STR\n            \n                \n                \n            \n        \n    \n    \n    \n        \n        \n            GLUTTON\n            Hard to kill, but consumes extra food.\n            -AGI / +HP\n            \n                \n                \n            \n        \n    \n    \n    \n        \n        \n            FRAGILE\n            Bruise easily. Learned medicine to survive.\n            -HP / +MEDIC"
  - "PARANOID\n            Trust no one. You repel potential allies.\n            -CHA / +SCAVENGE"
  - "INSOMNIAC\n            You never sleep well. Used to the dark.\n            -HP / +STEALTH"
  - "CLEAN\n            Obsessed with hygiene. Blood causes stress.\n            -HUMANITY / +HEAL"
  - "COWARD\n            Freeze in combat, but run fast.\n            -STR / +ESCAPE"
  - "PYRO\n            Obsessed with fire. Zero empathy.\n            -HUMANITY / +TECH"
  - "LONE WOLF\n            Rude and abrasive. Stronger when alone.\n            -CHA / +STEALTH"
  - "LUDDITE\n            Hate technology. Excellent with nature.\n            -TECH / +SCAVENGE"
  - "PACIFIST\n            Refuse to kill humans. Negotiator.\n            -COMBAT / +HUM"
  - "CLUMSY\n            Loud and accident-prone. Tough.\n            -STEALTH / +STR"
  - "GAMBLER\n            Took risks with money. Relies on luck.\n            -INT / +LUCK"
  - "SHELTERED\n            Naive about the world. Optimistic.\n            -SCAVENGE / +HUMANITY"
  - "SHOPPER\n            Carries useless things. Good at bartering.\n            -BAG SLOTS / +CHA"
  - "ARROGANT\n            You correct everyone. Unlikable.\n            -CHA / +INT"
  dialogueLines: []
  initialFloorItems: []
  choices: []
