  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<color=#94A3B8>[STATIC HISS]</color>


    <b><color=#38BDF8>UNIT 4-CHARLIE:</color></b>

    <i>"Dispatch, 4-Charlie! We''ve lost the 5th Street barricade! They are not stopping! I repeat, shooting them in the chest does nothing! They just keep coming!"</i>


    <color=#EF4444><b>[HEAVY STRUGGLE / THUD]</b></color>


    <b><color=#38BDF8>UNIT 4-CHARLIE:</color></b>

    <i>"God damn it, get off the damn car! Dispatch, standard protocol is useless! Requesting authorization for unrestricted lethal force!"</i>


    <color=#F59E0B><b>[RADIO SQUELCH]</b></color>


    <b><color=#F59E0B>DISPATCH (CALM):</color></b>

    <i>"4-Charlie, unrestricted lethal force is authorized. All units, listen carefully. Standard rules of engagement are suspended. Body shots will not stop them. You must destroy the brain. <color=#EF4444>Aim for the head.</color> I repeat... <color=#EF4444>aim for the head.</color> Avoid all physical contact."</i>


    <color=#EF4444><b>[SIGNAL CUTS OUT]</b></color>'
  m_isRightToLeft: 0
