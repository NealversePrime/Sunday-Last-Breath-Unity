  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#f39c12><b>THE ASCOTT RESIDENCY \u2014 4TH FLOOR</b></color>\n\n  \u250C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n  \u2502 UNIT 408  \u2502 UNIT 407  \u2502  [NORTH END]\n  \u2502  [LOCKED] \u2502  [BARRIC] \u2502\n  \u251C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n  \u2502     HALLWAY CORRIDOR  \u2502\n  \u251C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n  \u2502<color=#2ecc71><b>*UNIT 404*</b></color> \u2502 UNIT 405  \u2502  <color=#2ecc71>\u25C0 YOU ARE HERE</color>\n  \u2502  (HOME)   \u2502 (UNKNOWN) \u2502\n  \u251C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n  \u2502     HALLWAY CORRIDOR  \u2502\n  \u251C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n  \u2502 UNIT 402  \u2502 ELEVATOR  \u2502  [EAST EXIT]\n  \u2502  [LOCKED] \u2502 [STAIRS]  \u2502  (Down to 2nd Fl)\n  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\n<color=#6c7a89><i>Exit your door to enter the Hallway.</i></color>"
  m_isRightToLeft: 0
